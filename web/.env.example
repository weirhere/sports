# Set to "true" to use real ESPN API instead of mock data
USE_ESPN=false

# ESPN API (no key required - uses public unofficial endpoints)
ESPN_API_BASE=https://site.api.espn.com/apis/site/v2/sports/football/college-football

# --- Live Activity broadcast service ---------------------------------------
# See docs/live-activities-service.md. None of these is set in production yet,
# and the service reports rather than fails when they are missing: no APNs
# config answers `apns-not-configured`, and no cron secret closes the endpoint
# outright (an unguarded push relay is worse than a missing feature).

# Shared secret for the poll route. The pinger sends it as
# `Authorization: Bearer <value>`. Generate with `openssl rand -hex 32`.
# Required — without it /api/live-activity/broadcast answers 401 to everyone.
LIVE_ACTIVITY_CRON_SECRET=

# APNs provider key. Step-by-step for creating these three:
# docs/live-activities-service.md § Creating the provider key.
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8's contents, BEGIN/END lines included. Real newlines or literal \n
# both work; a missing BEGIN/END line does not.
APNS_PRIVATE_KEY=

# Optional, and both default correctly today.
# APNS_BUNDLE_ID defaults to com.andyryanweir.sports.
# APNS_ENVIRONMENT defaults to sandbox — anything but the literal
# "production" is sandbox, and the two are separate channel namespaces.
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=

# Broadcast channels, keyed `<league>:<gameId>`, e.g.
# {"cfb:401":"<channel-id>"}. Created by hand in Apple's Push Notification
# Console, because channel creation is on APNs' management host at port 2196
# and a serverless runtime cannot be assumed to reach it.
APNS_CHANNELS=
