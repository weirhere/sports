<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Restored 2026-09-15, ahead of the broadcast service rather than with
	     it, because first light needs a real device and a real device needs
	     this. It was removed for a precise reason — the App ID carried no
	     Push Notifications capability, so signing failed on a profile that
	     could not include the entitlement — and that reason is gone the
	     moment the capability is ticked in the developer portal. Step 1 of
	     `docs/live-activities-service.md` § Creating the provider key.

	     **If an archive or a device build starts failing to sign, the
	     capability is off.** Turn it on for `com.andyryanweir.sports` rather
	     than deleting this key again; deleting it is how the sequence got
	     lost the first time.

	     `development` is correct here for both configurations: Xcode
	     substitutes `production` when exporting for App Store distribution,
	     so a second entitlements file would be two things to keep in step
	     for no gain. Nothing in a build can use push until
	     `LiveActivityController.isAvailable` is true, which is still a
	     DEBUG-only default with no channels configured. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.andyryanweir.sports</string>
	</array>
</dict>
</plist>
